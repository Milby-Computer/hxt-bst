               "1171": {
                  "#name": "field \"Details\"",
                  "properties": {
                     "htmlText": {
                        "1114": "%file%: assets/revDocsSupported Platforms Reference_1174_1171_htmlText_1114.txt",
                        "1119": "<p>Applications created with Revolution can run on any version of OS X for Macintosh computers.</p>",
                        "1124": "<p>Applications created with Revolution can run on Windows 95, Windows 98, Windows ME, Windows NT, Windows 2000, or Windows XP.</p>\n<p></p>\n<p>Applications can also run on Windows 3.1 (with Win32s).</p>",
                        "1129": "<p>Applications created with Revolution can run on 1.2.13 ELF or any later version of Linux for Intel architecture.</p>",
                        "1134": "<p>Applications created by Revolution can run on 2.0 ELF or any later version of Linux for PowerPC architecture (LinuxPPC or MkLinux).</p>",
                        "1139": "<p>Applications created on Revolution can run on FreeBSD and BSDI UNIX.</p>",
                        "1144": "<p>Applications created with Revolution can run on version 10.20 or any later version of HP-UX.</p>",
                        "1149": "<p>Applications created with Revolution can run on version 5.3 or any later version of Silicon Graphics IRIX.</p>",
                        "1154": "<p>Applications created with Revolution can run on version 3.2.3 or any later version of AIX for IBM RS/6000.</p>",
                        "1159": "<p>Applications created with Revolution can run on version 2.5 or any later version of Sun Solaris for Intel architecture.</p>",
                        "1164": "<p>Applications created with Revolution can run on version 4.1 or any later version of SPARC SunOS.</p>",
                        "1169": "<p>Applications created with Revolution can run on version 2.3 or any later version of SPARC Solaris.</p>",
                        "1177": "<p>Applications created with Revolution can run on version 2.0 or any later version of SCO Open DeskTop/UnixWare.</p>"
                     },
                     "id": "1171",
                     "layer": "6",
                     "name": "Details",
                     "rect": "164,27,474,132",
                     "showBorder": false,
                     "showFocusBorder": false,
                     "style": "opaque"
                  }
               },
